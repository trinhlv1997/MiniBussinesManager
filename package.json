{
  "name": "mini-business-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler dev --port 8787",
    "typecheck": "wrangler types && tsc -b",
    "types": "wrangler types",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && vite build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "tsx scripts/seed.ts --local",
    "admin:create:remote": "tsx scripts/seed.ts --remote",
    "deploy": "npm run check && npm run db:migrate:remote && wrangler deploy",
    "postinstall": "wrangler types",
    "setup": "tsx scripts/setup-local.ts && npm run db:migrate:local && npm run db:seed:local",
    "db:prepare-restore": "tsx scripts/prepare-restore.ts",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && npm run setup",
    "db:seed:demo:remote": "tsx scripts/seed.ts --remote --demo"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^7.0.7",
    "@tanstack/react-query": "^5.108.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "lucide-react": "^1.74.0",
    "pdfmake": "^0.3.15",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router": "^8.5.1",
    "recharts": "^3.11.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.0",
    "@cloudflare/vitest-plugin": "^1.8.4",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  }
}
