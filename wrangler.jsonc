{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mini-business-manager",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    // Chỉ API mới gọi Worker; file tĩnh được phục vụ trực tiếp, không tính CPU của Worker.
    "run_worker_first": ["/api/*"]
  },
  "vars": { "APP_ENV": "production" },
  // Dọn dẹp hằng đêm lúc 02:00 giờ Việt Nam (19:00 UTC): nhật ký cũ hơn 30 ngày, phiên hết hạn.
  "triggers": { "crons": ["0 19 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mini-business-manager",
      // Thay bằng database_id thật từ `wrangler d1 create` trước khi deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
